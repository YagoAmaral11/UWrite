<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="using:System">

	<!-- Cores Principais - Tema Escuro -->
	<Color x:Key="BackgroundColor">#1E1E1E</Color>
	<Color x:Key="BackgroundSecondaryColor">#2D2D2D</Color>
	<Color x:Key="ForegroundColor">#FFFFFF</Color>
	<Color x:Key="HighlightColor">#0E7490</Color>
	<Color x:Key="HighlightHoverColor">#06B6D4</Color>
	<Color x:Key="SubTextColor">#A0A0A0</Color>
	<Color x:Key="SubTextColorLighter">#787878</Color>
	<Color x:Key="SeparatorColor">#404040</Color>
	<Color x:Key="AccentColor">#06B6D4</Color>

	<SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
	<SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}" />
	<SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
	<SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
	<SolidColorBrush x:Key="HighlightHoverBrush" Color="{StaticResource HighlightHoverColor}" />
	<SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource SubTextColor}" />
	<SolidColorBrush x:Key="SubTextBrushLighter" Color="{StaticResource SubTextColorLighter}" />
	<SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
	<SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

</ResourceDictionary>