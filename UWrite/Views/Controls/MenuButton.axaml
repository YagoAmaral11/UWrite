<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="using:UWrite.Views.Controls"
             x:Class="UWrite.Views.Controls.MenuButtonView"
             Width="200"
             Height="50">

	<Button Background="Transparent"
            BorderThickness="0"
            Padding="16,8"
            HorizontalContentAlignment="Left">
		
		<Button.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceInclude Source="avares://UWrite/Resources/Colors.axaml" />
				</ResourceDictionary.MergedDictionaries>
			</ResourceDictionary>
		</Button.Resources>

		<StackPanel Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
			<!-- Ícone -->
			<TextBlock x:Name="IconTextBlock"
                       FontSize="24"
                       Foreground="{StaticResource ForegroundBrush}"
                       VerticalAlignment="Center" />

			<!-- Texto do botão -->
			<TextBlock x:Name="ButtonTextBlock"
                       FontSize="16"
                       Foreground="{StaticResource ForegroundBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
		</StackPanel>

		<Button.Styles>
			<Style Selector="Button:pointerover">
				<Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}" />
			</Style>
		</Button.Styles>
		
	</Button>
</UserControl>