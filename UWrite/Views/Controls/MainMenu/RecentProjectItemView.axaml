<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UWrite.Views.Controls.MainMenu.RecentProjectItemView"
			 xmlns:local="using:UWrite.Views.Controls.MainMenu"
			 x:DataType="local:RecentProjectItemView"
             Height="80"
             Padding="12">

	<Button Background="Transparent"
            BorderThickness="1"
            BorderBrush="{StaticResource SeparatorBrush}"
            CornerRadius="6"
            Padding="12"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">

		<Button.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceInclude Source="avares://UWrite/Resources/Colors.axaml" />
				</ResourceDictionary.MergedDictionaries>
			</ResourceDictionary>
		</Button.Resources>

		<Grid ColumnDefinitions="48,9*,1*" RowDefinitions="Auto, Auto" ColumnSpacing="12">
			<!-- Ícone -->
			<Image     Grid.Row="0"
                       Grid.RowSpan="2"
                       Grid.Column="0"
					   Height="32"
					   Width="32"
                       Source="{Binding ProjectImage}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />

			<!-- Título do Projeto -->
			<TextBlock Grid.Row="0"
                       Grid.Column="1"
                       x:Name="ProjectNameTextBlock"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ForegroundBrush}"
                       VerticalAlignment="Center" 
					   Text="{Binding ProjectName}" />

			<!-- Caminho do Projeto -->
			<TextBlock Grid.Row="1"
                       Grid.Column="1"
                       x:Name="ProjectPathTextBlock"
                       FontSize="10"					   
					   FontStyle="Italic"
                       Foreground="{StaticResource SubTextColorLighter}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
					   Text="{Binding ProjectPath}"/>

			<!-- Data/Hora de Modificação -->
			<TextBlock Grid.Row="0"
                       Grid.RowSpan="2"
                       Grid.Column="2"
                       x:Name="ModificationDateTextBlock"
                       FontSize="8"
                       Foreground="{StaticResource SubTextBrushLighter}"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Right" 
					   Text="{Binding ProjectLastModified}"/>
		</Grid>

		<Button.Styles>
			<Style Selector="Button:pointerover">
				<Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}" />
			</Style>
		</Button.Styles>
	</Button>
</UserControl>